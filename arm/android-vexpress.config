# Android 4.4 (KitKat) on QEMU vexpress-a15, merged on top of vexpress_defconfig
# Android kernel drivers (staging)
CONFIG_STAGING=y
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_IPC_32BIT=y
CONFIG_ASHMEM=y
CONFIG_ANDROID_LOGGER=y
CONFIG_ANDROID_LOW_MEMORY_KILLER=y
CONFIG_ANDROID_INTF_ALARM_DEV=y
CONFIG_ANDROID_TIMED_OUTPUT=y
CONFIG_SYNC=y
CONFIG_SW_SYNC=y
CONFIG_SW_SYNC_USER=y
# /sys/power/wake_lock
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_GC=y
# cgroups used by init.rc
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_RT_GROUP_SCHED=y
# storage: system/cache/data/sdcard as virtio-mmio disks (vda..vdd)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_FUSE_FS=y
# display: PL111 CLCD framebuffer -> /dev/graphics/fb0
CONFIG_FB=y
CONFIG_FB_ARMCLCD=y
# no fbcon: its blinking text cursor draws over Android on fb0
CONFIG_FRAMEBUFFER_CONSOLE=n
# input: PL050 KMI keyboard + mouse
CONFIG_INPUT_EVDEV=y
CONFIG_SERIO_AMBAKMI=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
# misc
CONFIG_HIGHMEM=y
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_RTC_DRV_PL031=y
CONFIG_IPV6=y
CONFIG_SECURITY_SELINUX=n
CONFIG_DEVTMPFS=n
# ext4 images with huge_file (SDK userdata, mke2fs defaults) need this to mount rw
CONFIG_LBDAF=y
