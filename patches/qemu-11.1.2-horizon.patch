+        error_setg(errp, "failed to create %zu bytes of JIT memory "
+                   "(result 0x%x); is the loader granting CodeMemory?",
+                   size, rc);
+        return -1;
+    }
+
+    region.start_aligned = buf_rw;
+    region.total_size = size;
+    tcg_splitwx_diff = buf_rx - buf_rw;
+
+    return PROT_READ | PROT_WRITE;
