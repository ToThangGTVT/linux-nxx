+/*
+ * Horizon only allows executable memory through CodeMemory objects, which
+ * libnx maps twice: RW for the owner and RX for execution. That is exactly
+ * TCG's split-wx model.
+ */
+static int alloc_code_gen_buffer_splitwx_horizon(size_t size, Error **errp)
+{
+    void *buf_rw, *buf_rx;
+    unsigned int rc;
+
+    rc = nxc_jit_alloc(size, &buf_rw, &buf_rx);
