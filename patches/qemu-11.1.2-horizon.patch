diff --git a/ui/sdl2-switch.c b/ui/sdl2-switch.c
new file mode 100644
index 000000000..aeb79e9c9
--- /dev/null
+++ b/ui/sdl2-switch.c
@@ -0,0 +1,306 @@
+/*
+ * Nintendo Switch controls for the SDL2 display
+ *
+ * The Switch has no keyboard or mouse, so Joy-Con input is translated into
+ * keys an Android guest understands, the left stick drives a pointer and the
+ * + button opens the system software keyboard to type text into the guest.
+ *
+ * With an absolute pointer (usb-tablet on the x86 PC machine) touches arrive
+ * as SDL's synthesized mouse events and map 1:1 to the screen. With only a
+ * relative mouse (PS/2 on ARM vexpress) the touch screen acts as a touchpad:
+ * drag to move the cursor, tap to click.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "ui/console.h"
+#include "ui/input.h"
+#include "ui/kbd-state.h"
+#include "ui/sdl2.h"
+#include <math.h>
+#include <nxcompat/frontend.h>
+
+#define STICK_DEADZONE 8000
+/* Pointer speed in guest pixels per poll at full stick deflection */
+#define STICK_MAX_SPEED 14
+/* Touchpad mode: guest pixels per screen pixel, and what counts as a tap */
+#define TOUCHPAD_SPEED 1.5f
+#define TAP_MAX_MS 200
+#define TAP_MAX_TRAVEL 0.02f
+
+static SDL_GameController *pad;
+static int ptr_x = -1, ptr_y = -1;
+static float rel_frac_x, rel_frac_y;
+
+static struct {
+    bool active;
+    SDL_FingerID id;
+    uint32_t down_ms;
+    float travel;
+} touch;
+
+static const QKeyCode button_keys[SDL_CONTROLLER_BUTTON_MAX] = {
+    [SDL_CONTROLLER_BUTTON_A]             = Q_KEY_CODE_RET,
+    [SDL_CONTROLLER_BUTTON_B]             = Q_KEY_CODE_AC_BACK,
+    [SDL_CONTROLLER_BUTTON_X]             = Q_KEY_CODE_AC_HOME,
+    [SDL_CONTROLLER_BUTTON_Y]             = Q_KEY_CODE_MENU,
+    [SDL_CONTROLLER_BUTTON_BACK]          = Q_KEY_CODE_ESC,      /* - */
+    [SDL_CONTROLLER_BUTTON_LEFTSHOULDER]  = Q_KEY_CODE_PGUP,     /* L */
+    [SDL_CONTROLLER_BUTTON_RIGHTSHOULDER] = Q_KEY_CODE_PGDN,     /* R */
+    [SDL_CONTROLLER_BUTTON_DPAD_UP]       = Q_KEY_CODE_UP,
+    [SDL_CONTROLLER_BUTTON_DPAD_DOWN]     = Q_KEY_CODE_DOWN,
+    [SDL_CONTROLLER_BUTTON_DPAD_LEFT]     = Q_KEY_CODE_LEFT,
+    [SDL_CONTROLLER_BUTTON_DPAD_RIGHT]    = Q_KEY_CODE_RIGHT,
+    [SDL_CONTROLLER_BUTTON_LEFTSTICK]     = Q_KEY_CODE_TAB,
+    [SDL_CONTROLLER_BUTTON_RIGHTSTICK]    = Q_KEY_CODE_SPC,
+};
+
+/* US layout: unshifted and shifted characters for each qcode */
+static const struct {
+    QKeyCode qcode;
+    char plain;
+    char shifted;
+} ascii_keys[] = {
+    { Q_KEY_CODE_1, '1', '!' }, { Q_KEY_CODE_2, '2', '@' },
+    { Q_KEY_CODE_3, '3', '#' }, { Q_KEY_CODE_4, '4', '$' },
+    { Q_KEY_CODE_5, '5', '%' }, { Q_KEY_CODE_6, '6', '^' },
+    { Q_KEY_CODE_7, '7', '&' }, { Q_KEY_CODE_8, '8', '*' },
+    { Q_KEY_CODE_9, '9', '(' }, { Q_KEY_CODE_0, '0', ')' },
+    { Q_KEY_CODE_MINUS, '-', '_' }, { Q_KEY_CODE_EQUAL, '=', '+' },
+    { Q_KEY_CODE_BRACKET_LEFT, '[', '{' },
+    { Q_KEY_CODE_BRACKET_RIGHT, ']', '}' },
+    { Q_KEY_CODE_BACKSLASH, '\\', '|' },
+    { Q_KEY_CODE_SEMICOLON, ';', ':' }, { Q_KEY_CODE_APOSTROPHE, '\'', '"' },
+    { Q_KEY_CODE_GRAVE_ACCENT, '`', '~' }, { Q_KEY_CODE_COMMA, ',', '<' },
+    { Q_KEY_CODE_DOT, '.', '>' }, { Q_KEY_CODE_SLASH, '/', '?' },
+    { Q_KEY_CODE_SPC, ' ', ' ' }, { Q_KEY_CODE_RET, '\n', '\n' },
+    { Q_KEY_CODE_A, 'a', 'A' }, { Q_KEY_CODE_B, 'b', 'B' },
+    { Q_KEY_CODE_C, 'c', 'C' }, { Q_KEY_CODE_D, 'd', 'D' },
+    { Q_KEY_CODE_E, 'e', 'E' }, { Q_KEY_CODE_F, 'f', 'F' },
+    { Q_KEY_CODE_G, 'g', 'G' }, { Q_KEY_CODE_H, 'h', 'H' },
+    { Q_KEY_CODE_I, 'i', 'I' }, { Q_KEY_CODE_J, 'j', 'J' },
+    { Q_KEY_CODE_K, 'k', 'K' }, { Q_KEY_CODE_L, 'l', 'L' },
+    { Q_KEY_CODE_M, 'm', 'M' }, { Q_KEY_CODE_N, 'n', 'N' },
+    { Q_KEY_CODE_O, 'o', 'O' }, { Q_KEY_CODE_P, 'p', 'P' },
+    { Q_KEY_CODE_Q, 'q', 'Q' }, { Q_KEY_CODE_R, 'r', 'R' },
+    { Q_KEY_CODE_S, 's', 'S' }, { Q_KEY_CODE_T, 't', 'T' },
+    { Q_KEY_CODE_U, 'u', 'U' }, { Q_KEY_CODE_V, 'v', 'V' },
+    { Q_KEY_CODE_W, 'w', 'W' }, { Q_KEY_CODE_X, 'x', 'X' },
+    { Q_KEY_CODE_Y, 'y', 'Y' }, { Q_KEY_CODE_Z, 'z', 'Z' },
+};
+
+static void type_text(struct sdl2_console *scon, const char *text)
+{
+    for (const char *c = text; *c; c++) {
+        for (size_t i = 0; i < ARRAY_SIZE(ascii_keys); i++) {
+            bool shift;
+
+            if (ascii_keys[i].plain == *c) {
+                shift = false;
+            } else if (ascii_keys[i].shifted == *c) {
+                shift = true;
+            } else {
+                continue;
+            }
+            if (shift) {
+                qkbd_state_key_event(scon->kbd, Q_KEY_CODE_SHIFT, true);
+            }
+            qkbd_state_key_event(scon->kbd, ascii_keys[i].qcode, true);
+            qkbd_state_key_event(scon->kbd, ascii_keys[i].qcode, false);
+            if (shift) {
+                qkbd_state_key_event(scon->kbd, Q_KEY_CODE_SHIFT, false);
+            }
+            break;
+        }
+    }
+}
+
+static void send_pointer(struct sdl2_console *scon)
+{
+    QemuConsole *con = scon->dcl.con;
+
+    if (qemu_input_is_absolute(con)) {
+        qemu_input_queue_abs(con, INPUT_AXIS_X, ptr_x, 0,
+                             surface_width(scon->surface));
+        qemu_input_queue_abs(con, INPUT_AXIS_Y, ptr_y, 0,
+                             surface_height(scon->surface));
+    }
+    qemu_input_event_sync();
+}
+
+/* Move a relative pointer, carrying sub-pixel remainders between calls */
+static void queue_rel(struct sdl2_console *scon, float dx, float dy)
+{
+    int ix, iy;
+
+    rel_frac_x += dx;
+    rel_frac_y += dy;
+    ix = (int)rel_frac_x;
+    iy = (int)rel_frac_y;
+    rel_frac_x -= ix;
+    rel_frac_y -= iy;
+    if (ix || iy) {
+        qemu_input_queue_rel(scon->dcl.con, INPUT_AXIS_X, ix);
+        qemu_input_queue_rel(scon->dcl.con, INPUT_AXIS_Y, iy);
+        qemu_input_event_sync();
+    }
+}
+
+static void click(struct sdl2_console *scon, InputButton btn)
+{
+    qemu_input_queue_btn(scon->dcl.con, btn, true);
+    qemu_input_event_sync();
+    qemu_input_queue_btn(scon->dcl.con, btn, false);
+    qemu_input_event_sync();
+}
+
+/* Touchpad emulation for guests without an absolute pointer */
+static bool handle_touchpad(struct sdl2_console *scon, SDL_Event *ev)
+{
+    switch (ev->type) {
+    case SDL_MOUSEMOTION:
+        return ev->motion.which == SDL_TOUCH_MOUSEID;
+    case SDL_MOUSEBUTTONDOWN:
+    case SDL_MOUSEBUTTONUP:
+        return ev->button.which == SDL_TOUCH_MOUSEID;
+    case SDL_FINGERDOWN:
+        if (!touch.active) {
+            touch.active = true;
+            touch.id = ev->tfinger.fingerId;
+            touch.down_ms = ev->tfinger.timestamp;
+            touch.travel = 0;
+        }
+        return true;
+    case SDL_FINGERMOTION:
+        if (touch.active && ev->tfinger.fingerId == touch.id && scon->surface) {
+            queue_rel(scon,
+                      ev->tfinger.dx * surface_width(scon->surface) * TOUCHPAD_SPEED,
+                      ev->tfinger.dy * surface_height(scon->surface) * TOUCHPAD_SPEED);
+            touch.travel += fabsf(ev->tfinger.dx) + fabsf(ev->tfinger.dy);
+        }
+        return true;
+    case SDL_FINGERUP:
+        if (touch.active && ev->tfinger.fingerId == touch.id) {
+            touch.active = false;
+            if (ev->tfinger.timestamp - touch.down_ms < TAP_MAX_MS &&
+                touch.travel < TAP_MAX_TRAVEL) {
+                click(scon, INPUT_BUTTON_LEFT);
+            }
+        }
+        return true;
+    default:
+        return false;
+    }
+}
+
+static void handle_trigger(struct sdl2_console *scon, SDL_Event *ev)
+{
+    static bool held[SDL_CONTROLLER_AXIS_MAX];
+    InputButton btn;
+    bool down = ev->caxis.value > 16384;
+
+    if (ev->caxis.axis == SDL_CONTROLLER_AXIS_TRIGGERRIGHT) {
+        btn = INPUT_BUTTON_LEFT;      /* ZR */
+    } else if (ev->caxis.axis == SDL_CONTROLLER_AXIS_TRIGGERLEFT) {
+        btn = INPUT_BUTTON_RIGHT;     /* ZL */
+    } else {
+        return;
+    }
+    if (held[ev->caxis.axis] == down) {
+        return;
+    }
+    held[ev->caxis.axis] = down;
+    if (ptr_x >= 0 && qemu_input_is_absolute(scon->dcl.con)) {
+        send_pointer(scon);
+    }
+    qemu_input_queue_btn(scon->dcl.con, btn, down);
+    qemu_input_event_sync();
+}
+
+/* Returns true if the event was consumed */
+bool sdl2_switch_handle_event(struct sdl2_console *scon, SDL_Event *ev)
+{
+    if (!qemu_input_is_absolute(scon->dcl.con) && handle_touchpad(scon, ev)) {
+        return true;
+    }
+
+    switch (ev->type) {
+    case SDL_CONTROLLERDEVICEADDED:
+        if (!pad) {
+            pad = SDL_GameControllerOpen(ev->cdevice.which);
+        }
+        return true;
+    case SDL_CONTROLLERBUTTONDOWN:
+    case SDL_CONTROLLERBUTTONUP: {
+        bool down = ev->type == SDL_CONTROLLERBUTTONDOWN;
+        uint8_t b = ev->cbutton.button;
+
+        if (b == SDL_CONTROLLER_BUTTON_START) {   /* + */
+            char text[512] = "";
+
+            if (down && nxfe_text_input(text, sizeof(text)) == 0) {
+                type_text(scon, text);
+            }
+            return true;
+        }
+        if (b < SDL_CONTROLLER_BUTTON_MAX && button_keys[b]) {
+            qkbd_state_key_event(scon->kbd, button_keys[b], down);
+        }
+        return true;
+    }
+    case SDL_CONTROLLERAXISMOTION:
+        handle_trigger(scon, ev);
+        return true;
+    default:
+        return false;
+    }
+}
+
+/* Move the pointer with the left stick; returns true while it is moving */
+bool sdl2_switch_poll(struct sdl2_console *scon)
+{
+    static bool initialized;
+    int ax, ay, w, h;
+
+    if (!initialized) {
+        initialized = true;
+        SDL_InitSubSystem(SDL_INIT_GAMECONTROLLER);
+        if (SDL_NumJoysticks() > 0 && SDL_IsGameController(0)) {
+            pad = SDL_GameControllerOpen(0);
+        }
+    }
+    if (!pad || !scon->surface) {
+        return false;
+    }
+
+    ax = SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_LEFTX);
+    ay = SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_LEFTY);
+    if (abs(ax) < STICK_DEADZONE && abs(ay) < STICK_DEADZONE) {
+        return false;
+    }
+
+    if (!qemu_input_is_absolute(scon->dcl.con)) {
+        queue_rel(scon,
+                  abs(ax) >= STICK_DEADZONE ? (float)ax * STICK_MAX_SPEED / 32767 : 0,
+                  abs(ay) >= STICK_DEADZONE ? (float)ay * STICK_MAX_SPEED / 32767 : 0);
+        return true;
+    }
+
+    w = surface_width(scon->surface);
+    h = surface_height(scon->surface);
+    if (ptr_x < 0) {
+        ptr_x = w / 2;
+        ptr_y = h / 2;
+    }
+    if (abs(ax) >= STICK_DEADZONE) {
+        ptr_x += ax * STICK_MAX_SPEED / 32767;
+    }
+    if (abs(ay) >= STICK_DEADZONE) {
+        ptr_y += ay * STICK_MAX_SPEED / 32767;
+    }
+    ptr_x = MAX(0, MIN(ptr_x, w - 1));
+    ptr_y = MAX(0, MIN(ptr_y, h - 1));
+    send_pointer(scon);
+    return true;
+}
