+/*
+ * OS specific functions for Nintendo Switch (Horizon OS / libnx)
+ *
+ * Horizon has no POSIX signals, resource limits or process names, so most
+ * of these are no-ops. Shutdown requests from the HOME menu are handled by
+ * the Switch frontend instead of SIGTERM.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+
+void os_setup_post(void)
+{
+}
+
+void os_set_line_buffering(void)
+{
+    setvbuf(stdout, NULL, _IOLBF, 0);
+}
+
+void os_setup_early_signal_handling(void)
+{
+}
+
+void os_set_proc_name(const char *s)
+{
+    error_report("Change of process name not supported by your OS");
+    exit(1);
+}
+
+void os_setup_signal_handling(void)
+{
+}
+
+void os_setup_limits(void)
+{
+}
+
+int os_mlock(bool on_fault)
+{
+    (void)on_fault;
+    return -ENOSYS;
+}
